{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "rootDir": "src/",
    "declarationDir": "lib/",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "lib": ["es2020"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "test"]
}
